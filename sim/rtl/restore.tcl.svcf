#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 1046x892+512+19}] != ""} {
    window geometry "Design Browser 1" 1046x892+512+19
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {[format {simple_system_tb.dut.u_bootloader}]} ]
browser set \
    -signalsort name
browser yview see [subst  {[format {simple_system_tb.dut.u_bootloader}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1440x1027+-1+26}] != ""} {
    window geometry "Waveform 1" 1440x1027+-1+26
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 173 \
    -units ns \
    -valuewidth 82
waveform baseline set -time 0


set groupId0 [waveform add -groups TB]

set groupId1 [waveform find -name UART_RX]
waveform hierarchy collapse $groupId1


set groupId1 [waveform find -name UART_TX]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups IMEM]

set groupId1 [waveform find -name IMEM_wb_s]
waveform hierarchy collapse $groupId1

waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups DMEM]

set groupId1 [waveform find -name DMEM_wb_s]
waveform hierarchy collapse $groupId1

waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups Bootloader]

set groupId1 [waveform find -name I2c_fsm]

set groupId2 [waveform find -name wb_fsm]

waveform hierarchy collapse $groupId1


set groupId1 [waveform find -name Bootloader_wb_m]
waveform hierarchy collapse $groupId1

waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups Ibex]

set groupId1 [waveform find -name IMEM_if]

set groupId2 [waveform find -name SRAM1]


set groupId2 [waveform find -name SRAM2]

waveform hierarchy collapse $groupId1


set groupId1 [waveform find -name DMEM_if]
set gpGlist1 [waveform hierarchy contents $groupId1]
set gpID1 [lindex $gpGlist1 0]
foreach {name attrs} [subst  {
    {[format {simple_system_tb.dut.dmem.sram.i_SRAM_1P_behavioral_bm.memory[0:1023]}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.addr[31:0]}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.be[3:0]}]} {-radix %b}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.clk}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.err}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.gnt}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.rdata[31:0]}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.req}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.rst_n}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.rvalid}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.wdata[31:0]}]} {}
    {[format {simple_system_tb.dut.u_wb_ibex_top.data_core.slave.we}]} {}
}] childcmds {
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID1] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID1 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist1 [lrange $gpGlist1 1 end]
    set gpID1 [lindex $gpGlist1 0]
}
waveform hierarchy collapse $groupId1


set groupId1 [waveform find -name IMEM_wb_m]
waveform hierarchy collapse $groupId1


set groupId1 [waveform find -name DMEM_wb_m]
waveform hierarchy collapse $groupId1

set gpGlist0 [waveform hierarchy contents $groupId0]
