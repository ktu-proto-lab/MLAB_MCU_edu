    {[format {simple_system_tb.dut.u_wb_ibex_top.inst_ibex_top.u_ibex_core.pc_id[31:0]}]} {-color #00ffff}
    {[format {simple_system_tb.dut.u_wb_ibex_top.inst_ibex_top.u_ibex_core.instr_rdata_id[31:0]}]} {}
    groupId123 {}
    groupId154 {}
    groupId167 {}
    groupId178 {}
}] childcmds {
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}
