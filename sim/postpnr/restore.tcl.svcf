#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 1278x767+1193+77}] != ""} {
    window geometry "Design Browser 1" 1278x767+1193+77
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {simulator::[format {simple_system_tb.dut.u_pit}]} ]
browser set \
    -signalsort name
browser yview see [subst  {simulator::[format {simple_system_tb.dut.u_pit}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 2560x1337+2559+-1}] != ""} {
    window geometry "Waveform 1" 2560x1337+2559+-1
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 173 \
    -units ns \
    -valuewidth 365
waveform baseline set -time 0


set groupId0 [waveform add -groups TB]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups IMEM]

set groupId1 [waveform find -name IMEM_wb_s]
waveform hierarchy collapse $groupId1

waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups DMEM]

set groupId1 [waveform find -name DMEM_wb_s]
waveform hierarchy collapse $groupId1

waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups Bootloader]

set groupId1 [waveform find -name I2c_fsm]

set groupId2 [waveform find -name wb_fsm]



set groupId1 [waveform find -name Bootloader_wb_m]

waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups Ibex]

set groupId1 [waveform find -name IMEM_if]
waveform hierarchy collapse $groupId1


set groupId1 [waveform find -name DMEM_if]
waveform hierarchy collapse $groupId1


set groupId1 [waveform find -name IMEM_wb_m]
waveform hierarchy collapse $groupId1


set groupId1 [waveform find -name DMEM_wb_m]
waveform hierarchy collapse $groupId1

set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {simulator::[format {simple_system_tb.dut.u_wb_ibex_top.inst_ibex_top.u_ibex_core.rst_ni}]} {}
    {simulator::[format {simple_system_tb.dut.u_wb_ibex_top.inst_ibex_top.u_ibex_core.pc_if[31:0]}]} {}
    {simulator::[format {simple_system_tb.dut.u_wb_ibex_top.inst_ibex_top.u_ibex_core.pc_id[31:0]}]} {-color #00ffff}
    {simulator::[format {simple_system_tb.dut.u_wb_ibex_top.inst_ibex_top.u_ibex_core.instr_rdata_id[31:0]}]} {}
    groupId110 {}
    groupId119 {}
    groupId131 {}
    groupId144 {}
}] childcmds {
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}


set groupId0 [waveform add -groups I2C]

set groupId1 [waveform find -name I2C_wb_s]

set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {simulator::[format {simple_system_tb.dut.SCL_Pad}]} {}
    {simulator::[format {simple_system_tb.dut.SDA_Pad}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.scl_pad_i}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.scl_pad_o}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.scl_padoen_o}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.sda_pad_i}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.sda_pad_o}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.sda_padoen_o}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.byte_controller.i2c_al}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.cr[7:0]}]} {-radix %b}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.prer[15:0]}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.txr[7:0]}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.rxr[7:0]}]} {}
    {simulator::[format {simple_system_tb.dut.u_i2c.u_i2c.ctr[7:0]}]} {-radix %b}
    {simulator::[format {simple_system_tb.dut.u_i2c.int_o}]} {}
    groupId174 {}
}] childcmds {
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups GPIO]

set groupId1 [waveform find -name GPIO_wb_s]

waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups PIT]

set groupId1 [waveform find -name PIT_wb_s]



set groupId0 [waveform add -groups RegFile]
waveform hierarchy collapse $groupId0


