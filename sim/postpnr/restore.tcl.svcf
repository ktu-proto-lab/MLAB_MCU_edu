# Load memory viewer instances
memviewer add -instanceonly  \
	[subst  {simulator::[format {simple_system_tb.dut.imem.sram2.i_SRAM_1P_behavioral_bm.memory[71]}]} ] \
	[subst  {simulator::[format {simple_system_tb.dut.imem.sram1.i_SRAM_1P_behavioral_bm.memory[0:1023]}]} ] \
	[subst  {simulator::[format {simple_system_tb.eeprom.MemoryBlock[0:65535]}]} ]

memviewer sidebar visibility partial

